rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && request.auth.token.email == 'ercanseyithasan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Her öğrencinin ilerlemesi kendi belgesinde; öğretmen hepsini okuyabilir.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Öğretmen ayarları (ör. açık yazılılar): herkes okur, yalnızca öğretmen yazar.
    match /ayar/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }
  }
}
